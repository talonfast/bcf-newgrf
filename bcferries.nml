    VEHI: return max(1, 130 >> cap_mode);
    return max(1, 260 >> cap_mode);
}
switch(FEAT_SHIPS, SELF, sw_cap_nexpedition, cargo_classes & bitmask(CC_PASSENGERS)) {
    0: sw_cap_nexpedition_freight;
    return max(1, 600 >> cap_mode);
}

item(FEAT_SHIPS, nexpedition, 22) {
    property {
        name: string(STR_NAME_NEXPEDITION);
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date: date(2009, 3, 1);
        model_life: 35;
        vehicle_life: 45;
        reliability_decay: 20;
        cost_factor: 175;
        running_cost_factor: 130;
        sprite_id: SPRITE_ID_NEW_SHIP;
        speed: 36.1 km/h;
        default_cargo_type: PASS;
        cargo_capacity: 600;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_EXPRESS, CC_PIECE_GOODS,
                                          CC_ARMOURED, CC_REFRIGERATED);
        non_refittable_cargo_classes: bitmask(CC_LIQUID, CC_BULK);
        cargo_allow_refit: [VEHI];
        refit_cost: 10;
        loading_speed: 30;
        sound_effect: SOUND_DEPARTURE_FERRY;
    }
    graphics {
        cargo_capacity: sw_cap_nexpedition;
        purchase_cargo_capacity: sw_cap_nexpedition;
        additional_text: return string(STR_DESC_NEXPEDITION);
        purchase: ss_nexpedition;
        default: sw_gfx_nexpedition;
    }
}


