        introduction_date: date(1959, 3, 1);
        model_life: 90;
        vehicle_life: 50;
        reliability_decay: 20;
        cost_factor: 150;
        running_cost_factor: 120;
        sprite_id: SPRITE_ID_NEW_SHIP;
        speed: 27.8 km/h;
        default_cargo_type: PASS;
        cargo_capacity: 1000;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_EXPRESS, CC_PIECE_GOODS,
                                          CC_ARMOURED, CC_REFRIGERATED);
        non_refittable_cargo_classes: bitmask(CC_LIQUID, CC_BULK);
        cargo_allow_refit: [VEHI];
        refit_cost: 10;
        loading_speed: 50;
        sound_effect: SOUND_DEPARTURE_FERRY;
    }
    graphics {
        cargo_capacity: sw_cap_coho;
        purchase_cargo_capacity: sw_cap_coho;
        additional_text: return string(STR_DESC_COHO);
        purchase: ss_coho;
        default: sw_gfx_coho;
    }
}


