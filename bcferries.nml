    0..3: ss_salish_heron;
    ss_salish_heron_mv;
}

// Vehicle deck: FIRS-style VEHI cargo counts one per car space, other
// freight gets two units per car space.
switch(FEAT_SHIPS, SELF, sw_cap_salish_heron_freight, cargo_type_in_veh) {
    VEHI: return max(1, 145 >> cap_mode);
    return max(1, 290 >> cap_mode);
}
switch(FEAT_SHIPS, SELF, sw_cap_salish_heron, cargo_classes & bitmask(CC_PASSENGERS)) {
    0: sw_cap_salish_heron_freight;
    return max(1, 600 >> cap_mode);
}

item(FEAT_SHIPS, salish_heron, 40) {
    property {
        name: string(STR_NAME_SALISH_HERON);
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
        introduction_date: date(2022, 3, 1);
        model_life: 40;
        vehicle_life: 45;
        reliability_decay: 20;
        cost_factor: 150;
        running_cost_factor: 90;
        sprite_id: SPRITE_ID_NEW_SHIP;
        speed: 28.7 km/h;
        default_cargo_type: PASS;
        cargo_capacity: 600;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_EXPRESS, CC_PIECE_GOODS,
                                          CC_ARMOURED, CC_REFRIGERATED);
        non_refittable_cargo_classes: bitmask(CC_LIQUID, CC_BULK);
        cargo_allow_refit: [VEHI];
        refit_cost: 10;
        loading_speed: 30;
        sound_effect: SOUND_DEPARTURE_FERRY;
        variant_group: salish;
    }
    graphics {
        cargo_capacity: sw_cap_salish_heron;
        purchase_cargo_capacity: sw_cap_salish_heron;
        additional_text: return string(STR_DESC_SALISH_HERON);
        purchase: ss_salish_heron;
        default: sw_gfx_salish_heron;
    }
}


