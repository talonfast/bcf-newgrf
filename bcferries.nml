    ss_coho_mv;
}

// Vehicle deck: FIRS-style VEHI cargo counts one per car space, other
// freight gets two units per car space.
switch(FEAT_SHIPS, SELF, sw_cap_coho_freight, cargo_type_in_veh) {
    VEHI: return max(1, 115 >> cap_mode);
    return max(1, 230 >> cap_mode);
}
switch(FEAT_SHIPS, SELF, sw_cap_coho, cargo_classes & bitmask(CC_PASSENGERS)) {
    0: sw_cap_coho_freight;
    return max(1, 1000 >> cap_mode);
}

item(FEAT_SHIPS, coho, 0) {
