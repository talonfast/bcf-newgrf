// BC Ferries NewGRF -- GENERATED by src/make_nml.py, do not edit by hand.

grf {
    grfid: "TFBC";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 4;
    min_compatible_version: 1;
    param 0 {
        cap_mode {
            type: int;
            name: string(STR_PARAM_CAP);
            desc: string(STR_PARAM_CAP_DESC);
            min_value: 0;
            max_value: 2;
            def_value: 0;
            names: {
                0: string(STR_PARAM_CAP_100);
                1: string(STR_PARAM_CAP_50);
                2: string(STR_PARAM_CAP_25);
            };
        }
    }
}

cargotable {
    PASS, MAIL, GOOD, VEHI
}


